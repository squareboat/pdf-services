{
  "name": "nest-serverless-boilerplate",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"config/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:serverless": "sls offline start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/pdf-service/src/main",
    "lint": "oxlint --type-aware apps/ libs/ config/",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^6.4.2",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@sparticuz/chromium": "^153.0.0",
    "@squareboat/nest-console": "^2.0.0",
    "@squareboat/nest-events": "^0.2.0",
    "@squareboat/nest-storage": "^1.0.0",
    "aws-serverless-express": "^3.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.7",
    "lodash": "^4.18.1",
    "puppeteer-core": "~25.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/aws-lambda": "^8.10.164",
    "@types/aws-serverless-express": "^3.3.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "jest": "^30.5.2",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "serverless": "^4.46.0",
    "serverless-offline": "^14.8.4",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
